# Copy me to .env and fill in the blanks. Makefile reads this; CI uses OIDC and ignores it entirely.

DATABRICKS_HOST=

# Auth - pick one:
#   a) databricks auth login --host $DATABRICKS_HOST  (leave the two lines below blank)
#   b) Paste OAuth M2M client_id / secret below
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
